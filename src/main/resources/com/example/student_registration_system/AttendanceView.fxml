<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.CheckBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.student_registration_system.controller.AttendanceController">
    <children>
        <GridPane hgap="10" vgap="10">
            <Label text="Select Group:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="groupPicker" onAction="#handleGroupSelection" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Select Student:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox fx:id="studentPicker" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Start Date:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <DatePicker fx:id="startDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="End Date:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <DatePicker fx:id="endDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Button text="Show Attendance" onAction="#handleShowAttendance" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        </GridPane>

        <CheckBox fx:id="showFilledOnly" text="Show Only Filled Days" onAction="#handleShowFilledDays"/>

        <TableView fx:id="attendanceTable">
            <columns>
                <TableColumn fx:id="studentIdColumn" text="Student ID" prefWidth="100"/>
                <!-- Date columns will be added dynamically -->
            </columns>
        </TableView>

        <Button text="Mark Attendance" onAction="#handleMarkAttendance"/>
        <Button text="Back to Main" onAction="#handleBackToMain"/>
    </children>
</VBox>