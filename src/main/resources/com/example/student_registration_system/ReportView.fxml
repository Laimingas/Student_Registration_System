<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.student_registration_system.controller.ReportController">
    <children>
        <GridPane hgap="10" vgap="10">
            <Label text="Start Date:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <DatePicker fx:id="startDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="End Date:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <DatePicker fx:id="endDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Group:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <ComboBox fx:id="groupPicker" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Button text="Generate Report" onAction="#handleGenerateReport" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <Button text="Back to Main" onAction="#handleBackToMain" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        </GridPane>
    </children>
</VBox>