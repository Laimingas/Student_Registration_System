<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.GridPane?>

<GridPane fx:controller="com.example.student_registration_system.controller.AttendanceController" xmlns:fx="http://javafx.com/fxml" alignment="CENTER" hgap="10" vgap="10">
    <Label text="Date:" />
    <DatePicker fx:id="datePicker" GridPane.columnIndex="1" />

    <Label text="Students:" GridPane.rowIndex="1" />
    <ListView fx:id="studentListView" GridPane.columnIndex="1" GridPane.rowIndex="1" />

    <Button text="Mark Attendance" onAction="#handleMarkAttendance" GridPane.rowIndex="2" GridPane.columnIndex="0" />
</GridPane>