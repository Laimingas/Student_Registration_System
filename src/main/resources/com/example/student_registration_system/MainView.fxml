<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.student_registration_system.controller.MainController">
    <children>
        <Button fx:id="manageStudentsButton" text="Manage Students" onAction="#handleManageStudents"/>
        <Button fx:id="manageGroupsButton" text="Manage Groups" onAction="#handleManageGroups"/>
        <Button fx:id="manageAttendanceButton" text="Manage Attendance" onAction="#handleManageAttendance"/>
        <Button fx:id="generateReportButton" text="Generate Report" onAction="#handleGenerateReport"/>
    </children>
</VBox>